{
  "name": "entrelinhas",
  "description": "Legenda em inglês e português ao mesmo tempo, com controles para estudar inglês.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "test-page": "vite e2e/test-page --port 4321 --strictPort"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/punycode": "2.1.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "punycode": "2.3.1",
    "zod": "4.6.7"
  }
}
